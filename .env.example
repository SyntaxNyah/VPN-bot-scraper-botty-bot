# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Required: Channel ID where the bot should post the blocklist embeds
DISCORD_CHANNEL_ID=

# Optional: Refresh interval in minutes (default 90 = every ~1.5h). Must be >= 30.
REFRESH_MINUTES=90

# Optional: Where to write the flat blocklist "notepad" file
BLOCKLIST_PATH=blocklist.txt

# Optional: Comma-separated feed names to disable, e.g. "tor,spamhaus_edrop"
DISABLED_FEEDS=
